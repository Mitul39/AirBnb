  classDef async fill:#f1eaff,stroke:#895ac7,color:#342050,stroke-width:1.5px
  classDef external fill:#eaf7ec,stroke:#4e9a61,color:#214c2b,stroke-width:1.5px
  classDef observe fill:#f8eafa,stroke:#a451ae,color:#4a2052,stroke-width:1.5px
  classDef delivery fill:#fffbdc,stroke:#b4a634,color:#4b4511,stroke-width:1.5px
  classDef critical fill:#ffe6e6,stroke:#c84b4b,color:#5a1e1e,stroke-width:2px
  classDef note fill:#f7f7f7,stroke:#777,color:#333,stroke-dasharray:4 3

